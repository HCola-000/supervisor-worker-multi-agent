# ============ LLM 模型（DeepSeek）============
# DeepSeek API 地址
BASE_URL=https://api.deepseek.com
# DeepSeek API key
API_KEY=

# ============ 联网搜索（Tavily）============
# Tavily API key，供 search 工具联网查找资料
# 申请地址：https://app.tavily.com
TAVILY_API_KEY=

# ============ LangSmith 追踪（可选）============
# 如需开启 LangSmith 追踪，填下面的 key 并把 TRACING 设为 true
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=first-bot
